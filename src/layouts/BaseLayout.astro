---
const { title = "My Site", description = "" } = Astro.props;

// 定义组件接受的 Props
export interface Props {
    title: string;
    description: string;
}

// 1. 获取当前页面的完整 URL 对象
const url = Astro.url;

// 2. 使用 Astro.site (来自 astro.config.mjs) 和 Astro.url.pathname 来构建完整的规范 URL
// 注意：我们在 pathname 的末尾添加一个斜杠，因为您的构建输出了 /about/index/
// 您的规范化 URL 策略是 'always' (带斜杠)
let canonicalURL = new URL(url.pathname, Astro.site);

// 特殊处理首页，确保首页不是 /index/
if (url.pathname === '/') {
    canonicalURL = new URL(url.pathname, Astro.site);
} else {
    // 确保所有非首页 URL 结尾都有斜杠，以匹配 /about/index/ 的路由
    // 如果您最终决定规范化 URL 不带斜杠，请在下面移除 .replace(/\/$/, "")
    canonicalURL = new URL(url.pathname.replace(/\/?$/, '/'), Astro.site);
}

// 确保您的 astro.config.mjs 中设置了 site: 'https://www.yourdomain.com'
// Astro.site 只有在配置了 site 属性时才有效。
---

