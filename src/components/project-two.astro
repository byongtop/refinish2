---
import { getCollection } from 'astro:content';

// 1. 获取 projects collection
const projects = await getCollection('projects');

// 2. 按日期降序取最新 5 个案例
const latestFive = projects
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 5);

// ----------------------------------------------------
// 注意: 为保持功能性，案例展示部分的 Owl Carousel JS 仍然保留
// ----------------------------------------------------
---
<section class="design-one pt-0">
    <div class="container">
        <div class="row align-items-center gutter-y-30">
            <div class="col-lg-6">
                <div class="design-one__left">
                    <div class="design-one__thumb">
                        <div class="design-one__thumb__item">
                            <img src="/assets/images/resources/design-1-1.webp" alt="Before and after color matching process on damaged surface">
                        </div>
                        <div class="design-one__thumb__item">
                            <img src="/assets/images/resources/design-1-2.webp" alt="Skilled technician repairing surface damage">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="design-one__right">
                    <div class="sec-title text-start">
                        <div class="d-flex align-items-center justify-content-start">
                            <img class="sec-title__image" src="/assets/images/shapes/sec-title-s-1.png" alt="Decorative icon">
                            <h6 class="sec-title__tagline">Expert Surface Restoration</h6>
                        </div>
                        <h3 class="sec-title__title">Flawless Repairs, Every Time</h3>
                    </div>
                    <div class="tabs-box wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='100ms'>
                        <div class="design-one__tab wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='300ms'>
                            <div class="design-one__tab__link tab-link">
                                <button data-tab="#research" class=" wallox-btn tab-btn active-btn">Precision Color & Texture Matching</button>
                                <button data-tab="#marketing" class=" wallox-btn tab-btn">Hand-Finished Craftsmanship</button>
                                <button data-tab="#planning" class=" wallox-btn tab-btn">Fast, Cost-Effective Solutions</button>
                            </div>
                        </div>

                        <div class="tabs-content">
                            <div class="design-one__inner fadeInUp animated tab active-tab" id="research">
                                <p class="design-one__inner__text">From floors and furniture to benchtops, stone, tiles, walls, and more, we fix scratches, chips, cracks, and worn surfaces with expert techniques. Repairs are seamless, durable, and almost invisible—no replacement needed, no hassle, just perfect results.</p>
                                <ul class="design-one__inner__item list-unstyled">
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> Skilled professionals who care about every detail</li>
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> High-quality materials tailored to each surface</li>
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> Guaranteed satisfaction with every repair</li>
                                </ul>
                            </div>
                            <div class="design-one__inner fadeInUp animated tab" id="marketing">
                                <p class="design-one__inner__text">the capital required to establish and scale-up wafer, solar cell and solar module manufacturing facilities is considerable, Turpis egestas pretiu enean pharetra magna ac placerat amet. Sit amet luctus</p>
                                <ul class="design-one__inner__item list-unstyled">
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> We’re professional</li>
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> We use quality material</li>
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> 100% customers satisfaction</li>
                                </ul>
                            </div>
                            <div class="design-one__inner fadeInUp animated tab" id="planning">
                                <p class="design-one__inner__text">the capital required to establish and scale-up wafer, solar cell and solar module manufacturing facilities is considerable, Turpis egestas pretiu enean pharetra magna ac placerat amet. Sit amet luctus</p>
                                <ul class="design-one__inner__item list-unstyled">
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> We’re professional</li>
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> We use quality material</li>
                                    <li class="design-one__inner__item__text"><i class="icon-check"></i> 100% customers satisfaction</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="project-two project-two--home">
    <div class="project-two__bg" style="background-image: url(/assets/images/backgrounds/project-bg.webp);"></div>
    
    <div class="container">
        <div class="project-two__top">
            <div class="row align-items-end gutter-y-30">
                <div class="col-lg-8">
                    <div class="sec-title text-start">
                        <div class="d-flex align-items-center justify-content-start">
                            <img class="sec-title__image" src="/assets/images/shapes/sec-title-s-1.png" alt="Decorative icon for surface projects">
                            <h6 class="sec-title__tagline">Our Complete Surface Restoration Projects</h6>
                        </div>
                        <h3 class="sec-title__title">Flawless Repairs Across Every Material</h3>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="project-two__nav">
                        <button class="project-two__carousel__nav--left" aria-label="Previous project"><span class="icon-angle-right"></span></button>
                        <button class="project-two__carousel__nav--right" aria-label="Next project"><span class="icon-angle-left"></span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="project-two__inner wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='400ms'>
        <div class="container">
            <div class="project-two__carousel project-two__carousel--two wallox-owl__carousel wallox-owl__carousel--custom-nav owl-carousel owl-theme" data-owl-nav-prev=".project-two__carousel__nav--left" data-owl-nav-next=".project-two__carousel__nav--right" data-owl-options='{
                "items": 1,
                "margin": 0,
                "loop": true,
                "smartSpeed": 700,
                "nav": false,
                "dots": false,
                "autoplay": true,
                "responsive": {
                    "0": { "items": 1 },
                    "576": { "items": 2, "margin": 30 },
                    "992": { "items": 3, "margin": 30 },
                    "1199": { "items": 4, "margin": 30 }
                }
            }'>

                {latestFive.map((p) => (
                    <div class="item">
                        <div class="project-card wow fadeInUp">
                            <div class="project-card__thumb">
                                <img src={p.data.listImage} alt={p.data.pageTitle}>
                            </div>
                            <div class="project-card__content">
                                <div class="project-card__content__inner">
                                    <h4 class="project-card__content__title"><a href={`/projects/${p.slug}`}>{p.data.pageTitle}</a></h4>
                                </div>
                                <a href={`/projects/${p.slug}`} class="project-card__content__link" aria-label={`View ${p.data.pageTitle} project details`}>
                                    <i class="icon-up-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <div class="project-two__shape">
        <img src="/assets/images/shapes/service-1-1.png" alt="Geometric decorative shape">
    </div>
    <div class="project-two__shape-two">
        <img src="/assets/images/shapes/service-1-2.png" alt="Geometric decorative shape">
    </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const projectCarousel = $('.project-two__carousel');
  if (projectCarousel.length) {
    projectCarousel.owlCarousel({
      items: 1,
      margin: 0,
      loop: true,
      smartSpeed: 700,
      nav: true,
      navText: [
        "<span class='icon-angle-right'></span>",
        "<span class='icon-angle-left'></span>"
      ],
      dots: false,
      autoplay: true,
      responsive: {
        0: { items: 1 },
        576: { items: 2, margin: 30 },
        992: { items: 3, margin: 30 },
        1199: { items: 4, margin: 30 }
      }
    });

    // 自定义左右按钮
    $('.project-two__carousel__nav--left').click(() => projectCarousel.trigger('prev.owl.carousel'));
    $('.project-two__carousel__nav--right').click(() => projectCarousel.trigger('next.owl.carousel'));
  }
});
</script>