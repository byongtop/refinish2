---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhyChooseOne from '../components/why-choose-one.astro';


const title = "Professional Surface Repair & Restoration Services | Refinish";
const description = "Expert repair and restoration for wood floors, benchtops, stone, tiles, furniture, and more. Fast, seamless, and cost-effective solutions for commercial and residential surfaces.";
---

<BaseLayout {title} {description}>

    <Header />


        <section class="page-header">
            <div class="page-header__bg" style="background-image: url(/assets/images/backgrounds/page-header-bg-service-floor-repair.jpg);"></div>
            <div class="container">
                <h1 class="page-header__title">Our Full Range of Surface Repair Services</h1>
                <div class="wallox-breadcrumb">
                    <ul class="wallox-breadcrumb__list list-unstyled">
                        <li><a href="/"><i class="icon-home"></i> Home</a></li>
                        <li><span>our service</span></li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="service-page">
            <div class="container">
                <div class="row gutter-y-30">
                    <div class="col-lg-4 col-md-6">
                        <div class="service-card wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='100ms'>
                            <div class="service-card__image">
                                <img src="/assets/images/service/service-wood-floor-repair.jpg" alt="Floor Repair">
                                <div class="service-card__image__item">
                                    <div class="service-card__hover__box service-card__hover__box--1"></div>
                                    <div class="service-card__hover__box service-card__hover__box--2"></div>
