---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TestimonialsContact from '../components/testimonials-contact.astro';
import ServiceDetailLeft from '../components/service_detail_left.astro';
import ProjectCarousel from '../components/project-carousel.astro';
import Quote from '../components/quote-request.astro';

// SEO 优化后的 Meta Data
const title = "Best Invisible Carpet Repair Sydney | Iron & Cigarette Burn Fix";
const description = "Best invisible carpet repair in Sydney. We fix cigarette burns, iron marks, pet damage, and holes using expert hand-tufted reweaving. Save thousands on replacement. Trusted by Sydney tenants for bond returns and luxury homeowners.";
const keyword = "carpet repair Sydney, invisible carpet restoration Sydney, carpet burn repair Sydney, fix carpet hole, pet damage carpet repair, bond return carpet repair, wool carpet reweaving, carpet patching Sydney";
---

<BaseLayout {title} {description} {keyword}>
    <Header />
    <section class="page-header">
            <div class="page-header__bg" style="background-image: url(assets/images/backgrounds/page-header-bg-service-carpet-repair.jpg);"></div>
            <div class="container">
                <h1 class="page-header__title">Invisible Carpet Repair Sydney: Save Your Bond with Expert Reweaving</h1>
                <p style="color: white; font-size: 1.2rem;">Seamless Hand-Tufted Reweaving - Virtually Invisible Results</p>
                <div class="wallox-breadcrumb">
                    <ul class="wallox-breadcrumb__list list-unstyled">
                        <li><a href="/"><i class="icon-home"></i> Home</a></li>
                        <li><span>Services</span></li>
                        <li><span>Carpet Repair Sydney</span></li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="service-details">
            <div class="container">
                <div class="row gutter-y-30">
                    <ServiceDetailLeft activeHref="/service-carpet-repair/" />
                    <div class="col-md-12 col-lg-8">
                        <div class="service-details__content">
                            <div class="service-details__thumbnail wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='300ms'>
                                <img src="/assets/images/service/service-detail-carpet-repair.jpg" alt="Professional Invisible Carpet Burn Repair Sydney">
                            </div>

                            <h2 class="service-details__title wow fadeInUp">Our Carpet Repair Philosophy: Fast, Invisible, and Cost-Effective</h2>
                            <p class="service-details__text wow fadeInUp">
                                If you are facing carpet damage, don't rush into an expensive replacement. At <strong>Refinish</strong>, we specialize in high-end carpet restoration across <strong>Greater Sydney</strong>. Unlike traditional carpet patching that leaves visible seams, our unique <strong>Hand-Tufted Reweaving</strong> technique restores damaged areas by integrating fibers directly back into the weave. 
                            </p>
                            <p class="service-details__text wow fadeInUp">
                                This non-invasive method is ideal for luxury homes, commercial spaces, and rental properties. Whether it is a small cigarette burn, a stubborn stain, or damage caused by a pet, our Sydney-based technicians ensure the repair is virtually undetectable, saving you time, stress, and thousands of dollars in replacement costs.
                            </p>

                            <h2 class="service-details__title wow fadeInUp">Our 5-Step Invisible Restoration Process</h2>
                            <div class="row" style="margin-bottom: 30px;">
                                <div class="col-md-12">
                                    <p>Our process is far more advanced than a simple "cut and paste" patch. Here is how we achieve seamless results for our Sydney clients:</p>
                                    <ul class="list-unstyled">
                                        <li><strong>1. Damage Assessment:</strong> We analyze the carpet’s fiber type (wool, nylon, or blend) and the specific direction of the pile.</li>
                                        <li><strong>2. Fiber Harvesting:</strong> We carefully extract original fibers from hidden areas of your carpet (such as inside a closet or under the skirting board) to ensure a 100% color and texture match.</li>
                                        <li><strong>3. Foundation Prepping:</strong> The damaged spot is cleaned and the backing is prepared without cutting large, unnecessary sections.</li>
                                        <li><strong>4. Hand-Tufted Reweaving:</strong> Using precision tools, our technicians manually weave the new fibers into the existing carpet structure, following the original pattern.</li>
                                        <li><strong>5. Final Grooming:</strong> The area is trimmed and blended, ensuring the height and density match the surrounding carpet perfectly.</li>
                                    </ul>
                                </div>
                            </div>

                            <h2 class="service-details__title wow fadeInUp">What We Can Fix: From Burns to Pet Damage</h2>
                            <p class="service-details__text wow fadeInUp">Our hand-tufted technique is versatile and works on all types of carpet fibers. In Sydney, we frequently assist clients with:</p>
                            <ul class="wow fadeInUp">
                                <li><strong>Cigarette & Iron Burns:</strong> We remove the scorched fibers and reweave new ones for a seamless look.</li>
                                <li><strong>Pet Damage:</strong> Scratches or tufts pulled up by cats and dogs are common, and our method is perfect for restoring these spots.</li>
                                <li><strong>Rental Bond Issues:</strong> Don't lose your bond! Our repairs pass even the strictest real estate inspections in Sydney.</li>
                                <li><strong>Worn Patches & Snags:</strong> High-traffic areas or snags from furniture can be reconstructed to look like new.</li>
                            </ul>

                            <h2 class="service-details__title wow fadeInUp">Serving All of Greater Sydney</h2>
                            <p class="service-details__text">We are a fully mobile surface restoration service. Our specialist technicians travel across the entire Sydney metropolitan area to provide professional on-site repairs. Our coverage includes:</p>

                            <div class="row" style="background: #f9f9f9; padding: 25px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #eee;">
                                <div class="col-md-3 col-sm-6 text-small" style="margin-bottom: 15px;">
                                    <strong style="color: #333;">City & Eastern Suburbs:</strong><br/>
                                    Sydney CBD, Pyrmont, Surry Hills, Bondi, Randwick, Coogee, Double Bay, Rose Bay, Maroubra.
                                </div>
                                
                                <div class="col-md-3 col-sm-6 text-small" style="margin-bottom: 15px;">
                                    <strong style="color: #333;">Northern Suburbs:</strong><br/>
                                    <strong>Macquarie Park</strong>, North Sydney, Chatswood, Ryde, Hornsby, Mosman, Manly, Dee Why, Brookvale.
                                </div>
                                
                                <div class="col-md-3 col-sm-6 text-small" style="margin-bottom: 15px;">
                                    <strong style="color: #333;">Inner West & West:</strong><br/>
                                    Newtown, Balmain, Strathfield, Burwood, Parramatta, Blacktown, Penrith, Rhodes, Olympic Park.
                                </div>
                                
                                <div class="col-md-3 col-sm-6 text-small" style="margin-bottom: 15px;">
                                    <strong style="color: #333;">South & Sutherland Shire:</strong><br/>
                                    Hurstville, Kogarah, Cronulla, Miranda, Taren Point, Sutherland, Campbelltown, Bankstown.
                                </div>
                            </div>
                            <div class="service-details__feature">
                                <div class="row wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='300ms'>
                                    <div class="col-lg-6">
                                        <div class="service-details__left">
                                            <ul class="service-details__list list-unstyled">
                                                <li class="service-details__list__item">
                                                    <div class="service-details__list__icon"><i class="icon-check"></i></div>
                                                    <span class="service-details__list__text">Passes Bond Inspections</span>
                                                </li>
                                                <li class="service-details__list__item">
                                                    <div class="service-details__list__icon"><i class="icon-check"></i></div>
                                                    <span class="service-details__list__text">Cost-Effective Alternative</span>
                                                </li>
                                                <li class="service-details__list__item">
                                                    <div class="service-details__list__icon"><i class="icon-check"></i></div>
                                                    <span class="service-details__list__text">Handcrafted Precision</span>
                                                </li>
                                                <li class="service-details__list__item">
                                                    <div class="service-details__list__icon"><i class="icon-check"></i></div>
                                                    <span class="service-details__list__text">12-Month Workmanship Warranty</span>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="service-details__right">
                                            <div class="service-details__thumb">
                                                <img src="/assets/images/service/service-1-9.png" alt="Invisible Carpet Repair Specialist Sydney">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h2 class="service-details__title wow fadeInUp">Frequently Asked Questions</h2>
                            <div class="faq-page__accordion wallox-accrodion wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='700ms' data-grp-name="wallox-accrodion">
                                <div class="accrodion">
                                    <div class="accrodion-title">
                                        <h4 class="accrodion-title__text"><span class="accrodion-title__icon"></span>Will the repaired area look different?</h4>
                                    </div>
                                    <div class="accrodion-content">
                                        <div class="inner">
                                            <p class="inner__text">No. Because we use fibers from your own carpet, the color and texture match is 100%. Our hand-tufted reweaving blends seamlessly into the original pattern.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="accrodion active">
                                    <div class="accrodion-title">
                                        <h4 class="accrodion-title__text"><span class="accrodion-title__icon"></span>How long does a carpet repair take?</h4>
                                    </div>
                                    <div class="accrodion-content">
                                        <div class="inner">
                                            <p class="inner__text">Most repairs take between 1 to 2 hours depending on the size of the damage. We work efficiently to minimize disruption to your day.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="accrodion">
                                    <div class="accrodion-title">
                                        <h4 class="accrodion-title__text"><span class="accrodion-title__icon"></span>Can you fix carpet burns from cigarettes or irons?</h4>
                                    </div>
                                    <div class="accrodion-content">
                                        <div class="inner">
                                            <p class="inner__text">Yes, burns are our specialty. We remove the melted fibers and re-insert fresh fibers, making the burn mark disappear completely.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="accrodion">
                                    <div class="accrodion-title">
                                        <h4 class="accrodion-title__text"><span class="accrodion-title__icon"></span>Is this method better than carpet patching?</h4>
                                    </div>
                                    <div class="accrodion-content">
                                        <div class="inner">
                                            <p class="inner__text">Absolutely. Traditional patching involves cutting out squares, which often leaves visible seams. Our hand-tufting method integrates with the carpet's original weave for a much more durable and invisible finish.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="cta-one" style="padding: 60px 0; background: #222; color: #fff; text-align: center;">
            <div class="container">
                <h2>Ready to Restore Your Carpet?</h2>
                <p>Send a photo of your carpet damage to <strong>0452 288 855</strong> for a fast, free quote anywhere in Sydney!</p>
                <a href="/contact" class="thm-btn" style="margin-top: 20px;">Get a Free Estimate</a>
            </div>
        </section>

        <ProjectCarousel category="Carpet" />
        <TestimonialsContact />
        <Quote />
      <Footer />
</BaseLayout>
