        <div class="testimonials-contact testimonials-contact--home">
            <div class="testimonials-contact__bg" style="background-image: url(/assets/images/backgrounds/team-bg.png);"></div>
            <div class="container">
                <div class="row gutter-y-30 align-items-center">
                    <div class="col-lg-12">
                        <div class="testimonials-contact__left wow fadeInLeft" data-wow-duration='1500ms' data-wow-delay='100ms'>
                            <div class="testimonials-contact__bg" style="background-image: url(/assets/images/shapes/testimonials-form-bg.png);"></div>
                            <div class="testimonials-contact__inner">
                                <div class="sec-title">
                                    <div class="d-flex align-items-center justify-content-start">
                                        <img class="sec-title__image" src="/assets/images/shapes/sec-title-s-1.png" alt="Decorative icon for client feedback">
                                        <h6 class="sec-title__tagline bw-split-in-right">Request a Free Quote</h6>
                                    </div>
                                    <h3 class="sec-title__title bw-split-in-up">Tell Us About Your Surface Repair Needs</h3>
                                </div>
                                <div class="testimonials-contact__form">
                                    <form class="contact-one__form form-one background-base wow fadeInUp" 
                                          data-wow-duration="1500ms" 
                                          name="contact-refinish" 
                                          method="POST" 
                                          data-netlify="true" 
                                          action="/success" 
                                          enctype="multipart/form-data">

                                        <input type="hidden" name="form-name" value="contact-refinish" />

                                        <div class="form-one__group">
                                            <div class="form-one__control">
                                                <label for="name">Your name*</label>
                                                <input id="name" type="text" name="name" placeholder="name" required>
                                            </div>
                                            <div class="form-one__control">
                                                <label for="email">Your Email*</label>
                                                <input type="email" id="email" name="email" placeholder="Email address" required>
                                            </div>
                                            <div class="form-one__control">
                                                <label for="subject">subject*</label>
                                                <input type="text" id="subject" name="subject" placeholder="select subject">
                                            </div>
                                            <div class="form-one__control">
                                                <label for="phone">Your Phone*</label>
                                                <input type="text" id="phone" name="phone" placeholder="e.g. 04xx xxx xxx" required>
                                            </div>

                                            <div class="form-one__control">
                                                <label for="company">Company name (if applicable)</label>
                                                <input type="text" id="company" name="company" placeholder="">
                                            </div>

                                            <div class="form-one__control">
                                                <label for="customer_type">What customer are you?*</label>
                                                <select id="customer_type" name="customer_type" class="custom-select-style" required>
                                                    <option value="" disabled selected>Please Select</option>
                                                    <option value="Home Owner">Home Owner</option>
                                                    <option value="Renter">Renter(End of Lease)</option>
                                                    <option value="Construction">Construction</option>
                                                    <option value="Other Trades">Other Trades</option>
                                                    <option value="Insurance">Insurance</option>
                                                    <option value="Real Estate Agent">Real Estate/Property Management</option>
                                                    <option value="Government">Government (DHA etc.)</option>
                                                    <option value="Corporate Office">Corporate Office</option>
                                                    <option value="Technology">Technology</option>
                                                    <option value="Small Business (SME)">Small Business (SME)</option>
                                                    <option value="Medium Business">Medium Business</option>
                                                    <option value="Big Corporate">Big Business</option>
                                                    <option value="Hospitality">Hospitality (Hotel/Restaurant)</option>
                                                    <option value="KSR Technicians">KSR Technicians</option>
                                                </select>
                                            </div>

                                            <div class="form-one__control">
                                                <label for="street">Street Address*</label>
                                                <input type="text" id="street" name="street" placeholder="e.g. 123 Bondi Rd" required>
                                            </div>
                                            <div class="form-one__control">
                                                <label for="suburb">Suburb*</label>
                                                <input type="text" id="suburb" name="suburb" placeholder="e.g. Bondi" required>
                                            </div>

                                            <div class="form-one__control">
                                                <label for="state">State*</label>
                                                <select id="state" name="state" required>
                                                    <option value="" disabled selected>Select State</option>
                                                    <option value="NSW">NSW (New South Wales)</option>
                                                    <option value="VIC">VIC (Victoria)</option>
                                                    <option value="QLD">QLD (Queensland)</option>
                                                    <option value="WA">WA (Western Australia)</option>
                                                    <option value="SA">SA (South Australia)</option>
                                                    <option value="TAS">TAS (Tasmania)</option>
                                                    <option value="ACT">ACT (Australian Capital Territory)</option>
                                                    <option value="NT">NT (Northern Territory)</option>
                                                </select>
                                            </div>

                                            <div class="form-one__control">
                                                <label for="postalcode">Postal Code*</label>
                                                <input type="text" id="postalcode" name="postalcode" placeholder="e.g. 2000" required>
                                            </div>
                                            <div class="form-one__control form-one__control--full">
                                                <label for="photo_far">Upload Damage Photos (Max 10MB total)*</label>
                                                <label for="photo_far">1. Overall View (Distance)*</label>
                                                <input type="file" id="photo_far" name="photo_far" accept="image/*" multiple>
                                                <label for="photo_close">2. Close-up (Detail)*</label>
                                                <input type="file" id="photo_close" name="photo_close" accept="image/*" multiple>
                                                <label for="photo_side">3. Side Light (Angle)</label>
                                                <input type="file" id="photo_side" name="photo_side" accept="image/*" multiple>
                                            </div>

                                            <div class="form-one__control form-one__control--full">
                                                <label for="message">Message*</label>
                                                <textarea name="message" id="message" placeholder="Describe the damage (e.g., location, material, size)" required></textarea>
                                            </div>
                                            <div class="form-one__control form-one__control--full">
                                                <button type="submit" class="wallox-btn wallox-btn__submite">Request Free Quote</button>
                                                <p class="form-instruction-text" style="margin-top: 15px; font-size: 13px; color: #7E7C76; line-height: 1.6;">
                                                    <i class="fa fa-info-circle" style="color: #D99C44; margin-right: 5px;"></i>
                                                    Providing detailed information and clear photos helps our Sydney specialists provide a 
                                                    <strong>fast and accurate quote</strong>. Most assessments are completed within 24 hours.
                                                </p>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
