---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Home - Wallox Painting & Wallpapering";
const description = "Wallox is a modern painting & wallpapering template for interior design, house painting, and all related services.";
---

<BaseLayout {title} {description}>

    <Header />
        <section class="page-header">
            <div class="page-header__bg" style="background-image: url(assets/images/backgrounds/page-header-bg-1-1.jpg);"></div>
            <div class="container">
                <h2 class="page-header__title">our projects</h2>
                <div class="wallox-breadcrumb">
                    <ul class="wallox-breadcrumb__list list-unstyled">
                        <li><a href="index.html"><i class="icon-home"></i> Home</a></li>
                        <li><span>our projects</span></li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Project section start -->
        <section class="project-page">
            <div class="container">
                <div class="row gutter-y-20 gutter-x-20">
                    <div class="col-lg-4 col-md-6">

                        <div class="project-card wow fadeInUp" data-wow-duration='00ms' data-wow-delay='00ms'>
                            <div class="project-card__thumb">
                                <img src="assets/images/project/project-1-1.jpg" alt="Ceiling Wallpaper">
                            </div>
                            <div class="project-card__content">
                                <div class="project-card__content__inner">
                                    <span class="project-card__content__subtitle">interior</span>
                                    <h4 class="project-card__content__title"><a href="project-details.html">Ceiling Wallpaper</a></h4>
                                </div>
                                <a href="project-details.html" class="project-card__content__link">
                                    <i class="icon-up-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">

                        <div class="project-card wow fadeInUp" data-wow-duration='00ms' data-wow-delay='00ms'>
                            <div class="project-card__thumb">
                                <img src="assets/images/project/project-1-2.jpg" alt="Ceiling Wallpaper">
                            </div>
                            <div class="project-card__content">
                                <div class="project-card__content__inner">
                                    <span class="project-card__content__subtitle">interior</span>
                                    <h4 class="project-card__content__title"><a href="project-details.html">Ceiling Wallpaper</a></h4>
                                </div>
                                <a href="project-details.html" class="project-card__content__link">
                                    <i class="icon-up-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">

                        <div class="project-card wow fadeInUp" data-wow-duration='00ms' data-wow-delay='00ms'>
                            <div class="project-card__thumb">
                                <img src="assets/images/project/project-1-3.jpg" alt="Ceiling Wallpaper">
                            </div>
                            <div class="project-card__content">
                                <div class="project-card__content__inner">
                                    <span class="project-card__content__subtitle">interior</span>
                                    <h4 class="project-card__content__title"><a href="project-details.html">Ceiling Wallpaper</a></h4>
                                </div>
                                <a href="project-details.html" class="project-card__content__link">
                                    <i class="icon-up-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">

                        <div class="project-card wow fadeInUp" data-wow-duration='00ms' data-wow-delay='00ms'>
                            <div class="project-card__thumb">
                                <img src="assets/images/project/project-1-4.jpg" alt="Ceiling Wallpaper">
                            </div>
                            <div class="project-card__content">
                                <div class="project-card__content__inner">
                                    <span class="project-card__content__subtitle">interior</span>
                                    <h4 class="project-card__content__title"><a href="project-details.html">Ceiling Wallpaper</a></h4>
                                </div>
                                <a href="project-details.html" class="project-card__content__link">
                                    <i class="icon-up-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">

                        <div class="project-card wow fadeInUp" data-wow-duration='00ms' data-wow-delay='00ms'>
                            <div class="project-card__thumb">
                                <img src="assets/images/project/project-1-5.jpg" alt="Ceiling Wallpaper">
                            </div>
                            <div class="project-card__content">
                                <div class="project-card__content__inner">
                                    <span class="project-card__content__subtitle">interior</span>
                                    <h4 class="project-card__content__title"><a href="project-details.html">Ceiling Wallpaper</a></h4>
                                </div>
                                <a href="project-details.html" class="project-card__content__link">
                                    <i class="icon-up-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">

                        <div class="project-card wow fadeInUp" data-wow-duration='00ms' data-wow-delay='00ms'>
                            <div class="project-card__thumb">
                                <img src="assets/images/project/project-1-6.jpg" alt="Ceiling Wallpaper">
                            </div>
                            <div class="project-card__content">
                                <div class="project-card__content__inner">
                                    <span class="project-card__content__subtitle">interior</span>
                                    <h4 class="project-card__content__title"><a href="project-details.html">Ceiling Wallpaper</a></h4>
                                </div>
                                <a href="project-details.html" class="project-card__content__link">
                                    <i class="icon-up-right-arrow"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Project section End -->

        <footer class="main-footer">
            <div class="main-footer__bg" style="background-image: url(assets/images/shapes/footer-bg-1-1.png);"></div>
            <div class="main-footer__top wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='300ms'>
                <div class="container">
                    <div class="main-footer__top__inner">
                        <div class="main-footer__logo">
                            <a href="index.html" class="footer-logo">
                                <img src="assets/images/logo-footer.png" width="202" alt="Wallox HTML Template">
                            </a>
                        </div>
                        <div class="main-footer__form">
                            <div class="main-footer__form__item">
                                <form action="#" data-url="MAILCHIMP_FORM_URL" class="main-footer__form__newsletter mc-form">
                                    <span class="icon-email main-footer__form__newsletter__icon"></span>
                                    <input type="text" name="EMAIL" placeholder="your email">
                                    <button type="submit" class="wallox-btn">Subscribe Now</button>
                                </form>
                                <div class="mc-form__response"></div>
                            </div>
                        </div>
                        <div class="main-footer__social">
                            <a href="https://facebook.com"><i class="icon-facebook1" aria-hidden="true"></i><span class="sr-only">Facebook</span></a>
                            <a href="https://twitter.com"> <i class="icon-twitter1" aria-hidden="true"></i> <span class="sr-only">Twitter</span></a>
                            <a href="https://instagram.com"><i class="icon-social-media" aria-hidden="true"></i><span class="sr-only">Instagram</span></a>
                            <a href="https://youtube.com"><i class="icon-youtube1" aria-hidden="true"></i><span class="sr-only">Youtube</span></a>
                        </div>
                    </div>
                </div>
            </div>
    <Footer />

</BaseLayout>
